%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e5a2aece85084553a53024922955ce7c, type: 3}
  m_Name: DefaultAnimationDecisions
  m_EditorClassIdentifier:
  nodes:
  - Name: CanRelease
    Expression: "StopEnabled && Grounded && !BrakeObstructed && InputReleased && NoProvider"
  - Name: AlreadyRunning
    Expression: "LastGait == Gait.Run || LastGait == Gait.Sprint"
  - Name: IdleLimit
    Expression: "Select(LastGait == Gait.Idle, IdleExit, IdleEnter)"
  - Name: SprintLimit
    Expression: "Select(LastGait == Gait.Sprint, SprintExit, SprintEnter)"
  - Name: RunLimit
    Expression: "Select(AlreadyRunning, RunExit, RunEnter)"
  - Name: SpeedGait
    Expression: "Select(Speed <= IdleLimit, Gait.Idle, Select(RequestedGait == Gait.Walk, Gait.Walk, Select(RequestedGait == Gait.Sprint && Speed >= SprintLimit, Gait.Sprint, Select(Speed > RunLimit, Gait.Run, Gait.Walk))))"
  - Name: Reversing
    Expression: "TurnSeconds > 0 && HasPreviousDirection && HasPreviousVelocity && DirectionDot <= ReverseLimit && VelocityDot <= ReverseLimit"
  - Name: ProjectedGait
    Expression: "Select(SpeedGait == Gait.Idle && (Turning || Resuming && Reversing) && TrajectoryValid && ForecastForwardSpeed > IdleExit, LastGait, SpeedGait)"
  - Name: BlendFromStride
    Expression: "CanStart && PreserveEntry && RequestedGait != Gait.Walk"
  - Name: RunDuringAction
    Expression: "RequestedGait == Gait.Run && (ActionActive || RecoversMovement)"
  branches:
  - Output: 0
    Name: "有效速度"
    When: "Valid"
    Value: "Speed > Select(MovingVariant, IdleEnter, IdleExit)"
  - Output: 0
    Name: "保留瞬移前变体"
    When: ""
    Value: "RetainedStride && MovingVariant"
  - Output: 1
    Name: "运动覆盖许可"
    When: ""
    Value: "GaitEnabled && OverrideActive"
  - Output: 2
    Name: "反向跨零时核对预测"
    When: ""
    Value: "GaitEnabled && TurnSeconds > 0 && Valid && TrajectoryValid && !Blocked && Speed <= IdleEnter && (MoveApproved || RecoversMovement)"
  - Output: 3
    Name: "松键后的反向请求"
    When: ""
    Value: "TurnEnabled && MoveApproved && BasicDisplacement && Grounded && !Blocked && HasReleaseDirection && ReleaseDot <= ReverseLimit"
  - Output: 4
    Name: "进入松键处理"
    When: ""
    Value: "(!MoveApproved && !RecoversMovement) || !HasDirection"
  - Output: 5
    Name: "直接大角度转向"
    When: ""
    Value: "TurnEnabled && Grounded && !Blocked && !Releasing && AccelerationValid && HasPreviousDirection && PreviousSpeed > IdleExit && DirectionChange + 0.001 >= DirectAngle && ActualTurnAngle + 0.001 >= DirectAngle"
  - Output: 6
    Name: "保留制动前步态"
    When: ""
    Value: "Releasing && Grounded && PreviousSpeed > IdleExit"
  - Output: 7
    Name: "保持收步"
    When: "CanRelease && Releasing && (Stopping || MainBrakeDue)"
    Value: "Release.Hold"
  - Output: 7
    Name: "更新制动时机"
    When: "CanRelease && Releasing && Braking"
    Value: "Release.Brake"
  - Output: 7
    Name: "记录松键动量"
    When: "CanRelease && !Releasing && MoveEnded && LastGait != Gait.Idle && GroundTravel > 0 && GroundTravel >= MinimumStopTravel && PreviousForwardSpeed > 0"
    Value: "Release.Begin"
  - Output: 7
    Name: "返回待机"
    When: ""
    Value: "Release.Idle"
  - Output: 8
    Name: "受阻按实速"
    When: "Blocked"
    Value: "SpeedGait"
  - Output: 8
    Name: "持续冲刺预混"
    When: "BlendFromStride && LastGait == Gait.Sprint && RequestedGait == Gait.Sprint"
    Value: "Gait.Sprint"
  - Output: 8
    Name: "跑步预混"
    When: "BlendFromStride && AlreadyRunning && ProjectedGait != Gait.Sprint"
    Value: "Gait.Run"
  - Output: 8
    Name: "获准迈步"
    When: "CanStart && ProjectedGait == Gait.Idle"
    Value: "Gait.Walk"
  - Output: 8
    Name: "实速或反向预测"
    When: ""
    Value: "ProjectedGait"
  - Output: 9
    Name: "反向转身"
    When: "Reversing"
    Value: "Stride.Turn"
  - Output: 9
    Name: "从待机起步"
    When: "LastGait == Gait.Idle && !FollowsOverride && !RunDuringAction && StartSeconds > 0"
    Value: "Stride.Start"
  - Output: 9
    Name: "延续短暂动作"
    When: "RemainingSeconds > 0 && !RunDuringAction"
    Value: "Stride.Continue"
  - Output: 9
    Name: "基础移动"
    When: ""
    Value: "Stride.Base"
  - Output: 10
    Name: "低速步行"
    When: "StopSpeed <= RunEnter"
    Value: "Gait.Walk"
  - Output: 10
    Name: "冲刺收步"
    When: "StopSpeed >= SprintExit && (LastGait == Gait.Sprint || PlayingGait == Gait.Sprint)"
    Value: "Gait.Sprint"
  - Output: 10
    Name: "跑步收步"
    When: ""
    Value: "Gait.Run"
  - Output: 11
    Name: "等待搜索间隔"
    When: ""
    Value: "!Special && Unchanged && !HasTrackedPlayback && SearchDelay > 0"
  - Output: 12
    Name: "检查继续播放"
    When: ""
    Value: "!Special"
  - Output: 13
    Name: "常规搜索间隔"
    When: ""
    Value: "0.10"
  - Output: 14
    Name: "当前候选可续播"
    When: ""
    Value: "CanWait && CanKeep && (SameCycle || IdleCrossing && !HasWinner || Moving && Unchanged && HasWinner && KeepCost <= BestCost + Margin)"
  - Output: 15
    Name: "主制动到期或提前承重"
    When: ""
    Value: "MainBrakeDue || LastLocomotion && EarlyStance"
  - Output: 16
    Name: "采用符合条件的候选行"
    When: ""
    Value: "true"
